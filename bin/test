#!/usr/bin/env bash
# Run the modelctl test suite (stdlib unittest, no dependencies).
# Pass extra args through, e.g. `bin/test -v` or `bin/test -k resolve`.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Prefer the project's own interpreter: pyproject declares >=3.13, while the
# system python3 may be much older, so `python3` would test a runtime nobody ships.
PY_BIN="$DIR/.venv/bin/python"
[ -x "$PY_BIN" ] || PY_BIN="python3"
exec env PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" \
  "$PY_BIN" -m unittest discover -s "$DIR/tests" -t "$DIR" "$@"
